# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/
venv/
.env

# Jupyter
.ipynb_checkpoints/

# VS Code / IDEs
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Data outputs (keep repo lean)
data/**
!data/.gitkeep

# Build artifacts
*.log
*.tmp
exports/
assets/
data/
output/

# ---------------------------------
# Geospatial data (DO NOT COMMIT)
# ---------------------------------

# Raster formats
*.tif
*.tiff
*.img

# Raster sidecars / metadata
*.hdr
*.aux
*.aux.xml
*.ovr
*.rrd
*.xml
*.prj
*.wld
*.tfw

# Vector formats (shapefiles + friends)
*.shp
*.shx
*.dbf
*.cpg
*.qix
*.sbn
*.sbx

# GeoPackages / other vector containers
*.gpkg
*.gdb/
*.gdb/**

# ---------------------------------
# Explicitly allow ZIPs
# ---------------------------------
!*.zip

# Local-only S3/AAD notebooks (contain creds/config)
notebooks/aad_s3/
notebooks/archive/aad_s3/
notebooks/*s3*
notebooks/*aws*
notebooks/*credentials*


